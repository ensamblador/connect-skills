# Mantener versionada la plantilla de variables del website
!.env.example

# === Amazon Connect IP: cached default AI system prompts ===
# AWS-owned content, not published under an open-source license and not
# in the public docs. Every user pulls their own copy from their Connect
# instance:
#   uv run --with boto3 python .kiro/scripts/refresh_system_prompts.py --region <region>
# See .kiro/skills/connect-ai-agent-author/system-prompts/NOTICE.md
.kiro/skills/connect-ai-agent-author/system-prompts/*.yaml
.kiro/skills/connect-ai-agent-author/system-prompts/_manifest.json

# === Machine-local MCP config ===
# Holds absolute paths to the uv binary and this checkout, so it names one
# machine and one user account. The versioned template is
# .kiro/mcp.example.json; its __setup__ key carries the instructions:
#   cp .kiro/mcp.example.json .kiro/settings/mcp.json
.kiro/settings/mcp.json
