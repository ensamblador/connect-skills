{
  "enabled": true,
  "name": "Refresh Connect Views",
  "description": "Re-scrapes the Amazon Connect View Dictionary Storybook and rewrites .kiro/steering/connect-views.md (component catalog, last_refreshed, checksum).",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "runCommand",
    "command": "uv run python .kiro/hooks/scripts/refresh_connect_views.py",
    "timeout": 300
  },
  "workspaceFolderName": "connect-skills",
  "shortName": "refresh-connect-views"
}
