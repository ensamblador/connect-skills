{
  "enabled": true,
  "name": "Refresh CDK Docs",
  "description": "Re-fetches the four AWS CDK reference pages (aws_connect, aws_lex, aws_wisdom, aws_bedrockagentcore) and rewrites the .kiro/steering/cdk-*.md construct catalogs (construct table, last_refreshed, checksum).",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "runCommand",
    "command": "uv run python .kiro/hooks/scripts/refresh_cdk_docs.py",
    "timeout": 300
  },
  "workspaceFolderName": "connect-skills",
  "shortName": "refresh-cdk-docs"
}
