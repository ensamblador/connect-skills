{
  "enabled": true,
  "name": "Refresh Connect Flow Language",
  "description": "Re-scrapes the Amazon Connect Flow language API reference and rewrites .kiro/steering/connect-flow-language.md (action catalog, last_refreshed, checksum).",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "runCommand",
    "command": "uv run python .kiro/hooks/scripts/refresh_connect_flow_language.py",
    "timeout": 300
  },
  "workspaceFolderName": "connect-skills",
  "shortName": "refresh-connect-flow-language"
}
