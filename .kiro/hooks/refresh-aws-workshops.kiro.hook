{
  "enabled": true,
  "name": "Refresh AWS Workshops",
  "description": "Re-renders every curated Amazon Connect AWS workshop and rewrites .kiro/steering/aws-workshops.md. Each entry is URL + one-liner + Modules; Playwright-rendered workshops have their module lists scraped from the live sidebar with cleanup/summary/next-steps boilerplate stripped, and curated bundle entries (e.g. multi-module bootcamps) emit their static module list with no network round-trip. Updates last_refreshed and content_checksum.",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "runCommand",
    "command": "uv run python .kiro/hooks/scripts/refresh_aws_workshops.py",
    "timeout": 300
  },
  "workspaceFolderName": "connect-skills",
  "shortName": "refresh-aws-workshops"
}