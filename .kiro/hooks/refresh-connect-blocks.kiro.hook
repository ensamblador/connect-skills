{
  "enabled": true,
  "name": "Refresh Connect Blocks",
  "description": "Pulls the Amazon Connect contact-block definitions and channel-support pages and rewrites .kiro/steering/connect-blocks.md (block table, last_refreshed, checksum).",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "runCommand",
    "command": "uv run python .kiro/hooks/scripts/refresh_connect_blocks.py",
    "timeout": 300
  },
  "workspaceFolderName": "connect-skills",
  "shortName": "refresh-connect-blocks"
}
