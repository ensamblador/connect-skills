{
  "enabled": true,
  "name": "Refresh System Prompts",
  "description": "Re-fetches every SYSTEM AI prompt from the my-connect-domain Connect AI agents domain and rewrites .kiro/skills/connect-ai-agent-author/system-prompts/*.yaml plus _manifest.json. The cache is read-only reference for the connect-ai-agent-author skill — see system-prompts/NOTICE.md for provenance and licensing. Override domain/region/profile via env vars (DOMAIN_ID, AWS_REGION, AWS_PROFILE) or CLI flags.",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "runCommand",
    "command": "uv run python .kiro/hooks/scripts/refresh_system_prompts.py",
    "timeout": 300
  },
  "workspaceFolderName": "connect-skills",
  "shortName": "refresh-system-prompts"
}
